            <column datatype="real" name="[FOB USD]" role="measure" type="quantitative" />
            <column caption="Combustibles (miles de millones USD)" datatype="real" default-format="n#,##0.0" name="[c_combustibles]" role="measure" type="quantitative"><calculation class='tableau' formula="(IF [Rubro] = 'Combustibles' THEN [FOB USD] END) / 1000000000"></calculation></column>
            <column datatype="real" name="[FOB energía eléctrica]" role="measure" type="quantitative" />
            <column caption="Energía eléctrica declarada (miles de millones USD)" datatype="real" default-format="n#,##0.0" name="[c_electrica]" role="measure" type="quantitative"><calculation class='tableau' formula="[FOB energía eléctrica] / 1000000000"></calculation></column>
            <column caption="Energía eléctrica declarada, donde supera a los combustibles" datatype="real" default-format="n#,##0.0" name="[c_electrica_arriba]" role="measure" type="quantitative"><calculation class='tableau' formula="IF SUM([c_electrica]) &gt; SUM([c_combustibles]) THEN SUM([c_electrica]) END"></calculation></column>
            <column-instance column="[Fecha]" derivation="Year" name="[yr:Fecha:ok]" pivot='key' type="ordinal" />
            <column-instance column="[c_combustibles]" derivation="Sum" name="[sum:c_combustibles:qk]" pivot='key' type="quantitative" />
