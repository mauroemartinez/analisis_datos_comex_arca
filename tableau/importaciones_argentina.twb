<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.3.0 (20263.25.1027.1305)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <BasicButtonObject />
    <BasicButtonObjectTextSupport />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='Importaciones ARCA' inline='true' name='federated.importaciones' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='importaciones_argentina' name='textscan.importaciones'>
            <connection class='textscan' directory='.' filename="importaciones_argentina.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.importaciones' name='importaciones_argentina.csv' table='[importaciones_argentina#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='es_AR' separator=','>
            <column datatype="date" name="Fecha" ordinal='0' />
            <column datatype="string" name="Rubro" ordinal='1' />
            <column datatype="string" name="Capítulo" ordinal='2' />
            <column datatype="string" name="N.º de capítulo" ordinal='3' />
            <column datatype="string" name="País de origen" ordinal='4' />
            <column datatype="string" name="País (mapa)" ordinal='5' />
            <column datatype="string" name="Región" ordinal='6' />
            <column datatype="string" name="Grupo de origen" ordinal='7' />
            <column datatype="string" name="Vía de transporte" ordinal='8' />
            <column datatype="string" name="Vía (grupo)" ordinal='9' />
            <column datatype="real" name="FOB USD" ordinal='10' />
            <column datatype="integer" name="Ítems" ordinal='11' />
            <column datatype="real" name="FOB últimos 12 meses" ordinal='12' />
            <column datatype="real" name="FOB 12 meses anteriores" ordinal='13' />
            <column datatype="real" name="FOB 2019" ordinal='14' />
            <column datatype="real" name="FOB energía eléctrica" ordinal='15' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column datatype="date" name="[Fecha]" role="dimension" type="ordinal" />
      <column datatype="string" name="[Rubro]" role="dimension" type="nominal" />
      <column datatype="string" name="[Capítulo]" role="dimension" type="nominal" />
      <column datatype="string" name="[N.º de capítulo]" role="dimension" type="nominal" />
      <column datatype="string" name="[País de origen]" role="dimension" type="nominal" />
      <column datatype="string" name="[País (mapa)]" role="dimension" type="nominal" semantic-role='[Country].[ISO3166_2]' />
      <column datatype="string" name="[Región]" role="dimension" type="nominal" />
      <column datatype="string" name="[Grupo de origen]" role="dimension" type="nominal" />
      <column datatype="string" name="[Vía de transporte]" role="dimension" type="nominal" />
      <column datatype="string" name="[Vía (grupo)]" role="dimension" type="nominal" />
      <column datatype="real" name="[FOB USD]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Ítems]" role="measure" type="quantitative" />
      <column datatype="real" name="[FOB últimos 12 meses]" role="measure" type="quantitative" />
      <column datatype="real" name="[FOB 12 meses anteriores]" role="measure" type="quantitative" />
      <column datatype="real" name="[FOB 2019]" role="measure" type="quantitative" />
      <column datatype="real" name="[FOB energía eléctrica]" role="measure" type="quantitative" />
      <column caption="FOB (miles de millones USD)" datatype="real" default-format="n#,##0.0" name="[c_fob_mm]" role="measure" type="quantitative"><calculation class='tableau' formula="[FOB USD] / 1000000000"></calculation></column>
      <column caption="FOB (millones USD)" datatype="real" default-format="n#,##0" name="[c_fob_m]" role="measure" type="quantitative"><calculation class='tableau' formula="[FOB USD] / 1000000"></calculation></column>
      <column caption="FOB de los últimos 12 meses (miles de millones USD)" datatype="real" default-format="n#,##0.0" name="[c_u12_mm]" role="measure" type="quantitative"><calculation class='tableau' formula="[FOB últimos 12 meses] / 1000000000"></calculation></column>
      <column caption="Media móvil de 12 meses" datatype="real" default-format="n#,##0.0" name="[c_mm12]" role="measure" type="quantitative"><calculation class='tableau' formula="WINDOW_AVG(SUM([FOB USD]) / 1000000000, -11, 0)"><table-calc ordering-type='Rows' /></calculation></column>
      <column caption="Importado en los últimos 12 meses" datatype="real" default-format='n"US$ "#,##0.0" mil M"' name="[c_kpi_u12]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / 1000000000"></calculation></column>
      <column caption="Variación contra los 12 meses anteriores" datatype="real" default-format='p"▲ "0.0%;"▼ "0.0%' name="[c_var]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / SUM([FOB 12 meses anteriores]) - 1"></calculation></column>
      <column caption="Peso en los últimos 12 meses" datatype="real" default-format="p0.0%" name="[c_peso]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / MIN({FIXED : SUM([FOB últimos 12 meses])})"></calculation></column>
      <column caption="Peso en el total o en el origen elegido" datatype="real" default-format="p0.0%" name="[c_peso_sel]" role="measure" type="quantitative"><calculation class='tableau' formula="IF COUNTD([País de origen]) = 1 THEN SUM([FOB últimos 12 meses]) / MIN({FIXED [País de origen] : SUM([FOB últimos 12 meses])}) ELSE SUM([FOB últimos 12 meses]) / MIN({FIXED : SUM([FOB últimos 12 meses])}) END"></calculation></column>
      <column caption="Peso en 2019" datatype="real" default-format="p0.0%" name="[c_peso_2019]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB 2019]) / MIN({FIXED : SUM([FOB 2019])})"></calculation></column>
      <column caption="Cambio de peso (puntos porcentuales)" datatype="real" default-format="n+0.0;-0.0" name="[c_cambio]" role="measure" type="quantitative"><calculation class='tableau' formula="([c_peso] - [c_peso_2019]) * 100"></calculation></column>
      <column caption="Ganó o perdió peso" datatype="string" name="[c_signo_peso]" role="measure" type="nominal"><calculation class='tableau' formula="IF [c_cambio] &gt;= 0 THEN 'Ganó peso' ELSE 'Perdió peso' END"></calculation></column>
      <column caption="Subió o bajó" datatype="string" name="[c_signo]" role="measure" type="nominal"><calculation class='tableau' formula="IF [c_var] &gt;= 0 THEN 'Subió' ELSE 'Bajó' END"></calculation></column>
      <column caption="Peso en el año" datatype="real" default-format="p0%" name="[c_peso_anio]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB USD]) / MIN({FIXED DATETRUNC('year', [Fecha]) : SUM([FOB USD])})"></calculation></column>
      <column caption="Peso en el último año" datatype="real" default-format="p0%" name="[c_peso_anio_final]" role="measure" type="quantitative"><calculation class='tableau' formula="IF MIN(YEAR([Fecha])) = MIN({FIXED : MAX(YEAR([Fecha]))}) THEN [c_peso_anio] END"></calculation></column>
      <column caption="Peso dentro del rubro" datatype="real" default-format="p0%" name="[c_peso_rubro]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / MIN({FIXED [Rubro] : SUM([FOB últimos 12 meses])})"></calculation></column>
      <column caption="Peso dentro de la región" datatype="real" default-format="p0%" name="[c_peso_region]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / MIN({FIXED [Región] : SUM([FOB últimos 12 meses])})"></calculation></column>
      <column caption="FOB medio por ítem (USD)" datatype="real" default-format='n"US$ "#,##0' name="[c_por_item]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / SUM(IF NOT ISNULL([FOB últimos 12 meses]) THEN [Ítems] END)"></calculation></column>
      <column caption="Es un país" datatype="boolean" name="[c_ubicable]" role="dimension" type="nominal"><calculation class='tableau' formula="NOT ISNULL([País (mapa)])"></calculation></column>
      <column caption="Combustibles (miles de millones USD)" datatype="real" default-format="n#,##0.0" name="[c_combustibles]" role="measure" type="quantitative"><calculation class='tableau' formula="(IF [Rubro] = 'Combustibles' THEN [FOB USD] END) / 1000000000"></calculation></column>
      <column caption="Energía eléctrica declarada (miles de millones USD)" datatype="real" default-format="n#,##0.0" name="[c_electrica]" role="measure" type="quantitative"><calculation class='tableau' formula="[FOB energía eléctrica] / 1000000000"></calculation></column>
      <column caption="Energía eléctrica declarada, donde supera a los combustibles" datatype="real" default-format="n#,##0.0" name="[c_electrica_arriba]" role="measure" type="quantitative"><calculation class='tableau' formula="IF SUM([c_electrica]) &gt; SUM([c_combustibles]) THEN SUM([c_electrica]) END"></calculation></column>
      <column caption="Mes" datatype="string" name="[c_mes_texto]" role="dimension" type="nominal"><calculation class='tableau' formula="DATENAME('month', [Fecha]) + ' de ' + STR(YEAR([Fecha]))"></calculation></column>
      <column caption="Ítems de despacho (miles)" datatype="real" default-format="n#,##0" name="[c_items_miles]" role="measure" type="quantitative"><calculation class='tableau' formula="[Ítems] / 1000"></calculation></column>
      <column caption="Origen elegido" datatype="string" name="[c_origen_elegido]" role="measure" type="nominal"><calculation class='tableau' formula="IF COUNTD([País de origen]) = 1 THEN MIN([País de origen]) ELSE 'Todos los orígenes' END"></calculation></column>
      <column caption="Rubro elegido" datatype="string" name="[c_rubro_elegido]" role="measure" type="nominal"><calculation class='tableau' formula="IF COUNTD([Rubro]) = 1 THEN MIN([Rubro]) ELSE 'Todos los rubros' END"></calculation></column>
      <column-instance column="[Grupo de origen]" derivation="None" name="[none:Grupo de origen:nk]" pivot='key' type="nominal" />
      <column-instance column="[Vía (grupo)]" derivation="None" name="[none:Vía (grupo):nk]" pivot='key' type="nominal" />
      <column-instance column="[c_signo_peso]" derivation="User" name="[usr:c_signo_peso:nk]" pivot='key' type="nominal" />
      <column-instance column="[c_signo]" derivation="User" name="[usr:c_signo:nk]" pivot='key' type="nominal" />
      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' authentication='auth-none' author-locale='es_AR' class='hyper' dbname="importaciones_argentina.hyper" default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' update-time='11/27/2026 01:00:00 AM' username='tableau-internal-user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
          <refresh incremental-updates='false' />
        </connection>
      </extract>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field="[none:Grupo de origen:nk]" type='palette'><map to='#0da4cf'><bucket>&quot;Brasil&quot;</bucket></map><map to='#795ec9'><bucket>&quot;China&quot;</bucket></map><map to='#a69722'><bucket>&quot;Unión Europea&quot;</bucket></map><map to='#4170cb'><bucket>&quot;Estados Unidos&quot;</bucket></map><map to='#3bab8d'><bucket>&quot;Áreas especiales&quot;</bucket></map><map to='#5e6b7d'><bucket>&quot;Resto del mundo&quot;</bucket></map></encoding>
          <encoding attr='color' field="[none:Vía (grupo):nk]" type='palette'><map to='#0da4cf'><bucket>&quot;Marítima&quot;</bucket></map><map to='#795ec9'><bucket>&quot;Camión&quot;</bucket></map><map to='#a69722'><bucket>&quot;Aérea&quot;</bucket></map><map to='#4170cb'><bucket>&quot;Ductos&quot;</bucket></map><map to='#5e6b7d'><bucket>&quot;Otras y sin informar&quot;</bucket></map></encoding>
          <encoding attr='color' field="[usr:c_signo_peso:nk]" type='palette'><map to='#0da4cf'><bucket>&quot;Ganó peso&quot;</bucket></map><map to='#b33879'><bucket>&quot;Perdió peso&quot;</bucket></map></encoding>
          <encoding attr='color' field="[usr:c_signo:nk]" type='palette'><map to='#0da4cf'><bucket>&quot;Subió&quot;</bucket></map><map to='#b33879'><bucket>&quot;Bajó&quot;</bucket></map></encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
  <actions>
    <action caption="Elegir un origen en el panorama" name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Panorama" type='sheet' worksheet="Principales orígenes" />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value="KPI origen,KPI rubro,Principales orígenes" />
        <param name='special-fields' value='all' />
        <param name='target' value="Panorama" />
      </command>
    </action>
    <action caption="Elegir un origen en el mapa" name='[Action2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Orígenes" type='sheet' worksheet="Mapa de orígenes" />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value="Mapa de orígenes,Ganadores y perdedores,Peso de los grupos" />
        <param name='special-fields' value='all' />
        <param name='target' value="Orígenes" />
      </command>
    </action>
    <action caption="Elegir un origen en el ranking" name='[Action3]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Orígenes" type='sheet' worksheet="Ganadores y perdedores" />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value="Mapa de orígenes,Ganadores y perdedores,Peso de los grupos" />
        <param name='special-fields' value='all' />
        <param name='target' value="Orígenes" />
      </command>
    </action>
    <action caption="Elegir un rubro en el mapa de productos" name='[Action4]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Productos" type='sheet' worksheet="Mapa de productos" />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value="Mapa de productos,Rubro por origen,Subas y bajas" />
        <param name='special-fields' value='all' />
        <param name='target' value="Productos" />
      </command>
    </action>
    <action caption="Elegir un rubro en la matriz" name='[Action5]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard="Productos" type='sheet' worksheet="Rubro por origen" />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value="Mapa de productos,Rubro por origen,Subas y bajas" />
        <param name='special-fields' value='all' />
        <param name='target' value="Productos" />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name="KPI importado">
      <table>
        <view>
          <datasources><datasource caption='Importaciones ARCA' name='federated.importaciones' /></datasources>

          <datasource-dependencies datasource='federated.importaciones'>
            <column datatype="real" name="[FOB últimos 12 meses]" role="measure" type="quantitative" />
            <column caption="Importado en los últimos 12 meses" datatype="real" default-format='n"US$ "#,##0.0" mil M"' name="[c_kpi_u12]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / 1000000000"></calculation></column>
            <column-instance column="[c_kpi_u12]" derivation="User" name="[usr:c_kpi_u12:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>

          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'><format attr='background-color' value='#051e4501' /></style-rule>
