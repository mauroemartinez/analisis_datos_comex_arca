    <worksheet name="KPI origen">
      <table>
        <view>
          <datasources><datasource caption='Importaciones ARCA' name='federated.importaciones' /></datasources>

          <datasource-dependencies datasource='federated.importaciones'>
            <column datatype="string" name="[País de origen]" role="dimension" type="nominal" />
            <column datatype="real" name="[FOB últimos 12 meses]" role="measure" type="quantitative" />
            <column caption="Peso en los últimos 12 meses" datatype="real" default-format="p0.0%" name="[c_peso]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([FOB últimos 12 meses]) / MIN({FIXED : SUM([FOB últimos 12 meses])})"></calculation></column>
            <column-instance column="[País de origen]" derivation="None" name="[none:País de origen:nk]" pivot='key' type="nominal" />
            <column-instance column="[c_peso]" derivation="User" name="[usr:c_peso:qk]" pivot='key' type="quantitative" />
            <column-instance column="[FOB últimos 12 meses]" derivation="Sum" name="[sum:FOB últimos 12 meses:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.importaciones].[none:País de origen:nk]"><groupfilter count='1' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression="SUM([FOB últimos 12 meses])" function='order' user:ui-marker='order'><groupfilter function='level-members' level="[none:País de origen:nk]" user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></filter>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'><format attr='background-color' value='#051e4501' /></style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='font-family' value='Tableau Book' />
            <format attr='color' value='#BBC5D1' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='font-size' value='8' /><format attr='color' value='#8D9AA8' />
            <format attr='stroke-color' value='#16284A' /><format attr='tick-color' value='#16284A' />
          </style-rule>
          <style-rule element='label'><format attr='font-size' value='9' /><format attr='color' value='#F0EEE9' /></style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='rows' value='on' />
            <format attr='stroke-color' scope='rows' value='#16284A' />
            <format attr='line-visibility' scope='cols' value='off' />
          </style-rule>
          <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='table-div'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='cell'><format attr='width' value='272' /><format attr='height' value='48' /><format attr='text-align' value='left' /></style-rule>
