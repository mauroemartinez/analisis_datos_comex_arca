    <worksheet name="Cobertura">
      <table>
        <view>
          <datasources><datasource caption='Importaciones ARCA' name='federated.importaciones' /></datasources>

          <datasource-dependencies datasource='federated.importaciones'>
            <column datatype="date" name="[Fecha]" role="dimension" type="ordinal" />
            <column caption="Mes" datatype="string" name="[c_mes_texto]" role="dimension" type="nominal"><calculation class='tableau' formula="DATENAME('month', [Fecha]) + ' de ' + STR(YEAR([Fecha]))"></calculation></column>
            <column datatype="integer" name="[Ítems]" role="measure" type="quantitative" />
            <column caption="Ítems de despacho (miles)" datatype="real" default-format="n#,##0" name="[c_items_miles]" role="measure" type="quantitative"><calculation class='tableau' formula="[Ítems] / 1000"></calculation></column>
            <column-instance column="[Fecha]" derivation="None" name="[none:Fecha:qk]" pivot='key' type="quantitative" />
            <column-instance column="[c_mes_texto]" derivation="Attribute" name="[attr:c_mes_texto:nk]" pivot='key' type="nominal" />
            <column-instance column="[c_items_miles]" derivation="Sum" name="[sum:c_items_miles:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>

          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'><format attr='background-color' value='#051e4501' /></style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='font-family' value='Tableau Book' />
            <format attr='color' value='#BBC5D1' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='font-size' value='8' /><format attr='color' value='#8D9AA8' />
            <format attr='stroke-color' value='#16284A' /><format attr='tick-color' value='#16284A' />
          </style-rule>
          <style-rule element='label'><format attr='font-size' value='9' /><format attr='color' value='#F0EEE9' /></style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' scope='rows' value='on' />
            <format attr='stroke-color' scope='rows' value='#16284A' />
            <format attr='line-visibility' scope='cols' value='off' />
          </style-rule>
          <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='table-div'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='axis'><format attr='title' class='0' field="[federated.importaciones].[none:Fecha:qk]" scope="cols" value='' /></style-rule><style-rule element='axis'><format attr='title' class='0' field="[federated.importaciones].[sum:c_items_miles:qk]" scope="rows" value='' /></style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Area" /><encodings><tooltip column="[federated.importaciones].[attr:c_mes_texto:nk]" /></encodings><customized-tooltip><formatted-text><run fontcolor='#051e45' fontname="Tableau Semibold" fontsize='10'>&lt;[federated.importaciones].[attr:c_mes_texto:nk]&gt;</run><run>Æ&#10;</run><run fontcolor='#3e4e66' fontname="Tableau Book" fontsize='9'>&lt;[federated.importaciones].[sum:c_items_miles:qk]&gt; mil ítems de despacho</run></formatted-text></customized-tooltip><style><style-rule element='mark'><format attr='mark-color' value='#3BAB8D' /></style-rule></style></pane>
        </panes>
        <rows>[federated.importaciones].[sum:c_items_miles:qk]</rows>
        <cols>[federated.importaciones].[none:Fecha:qk]</cols>
