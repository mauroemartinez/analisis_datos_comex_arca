# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/
# Notebooks often contain outputs, notes, local paths, and exploratory results.
# Tracked only under /notebooks/, and only reviewed and cleaned (no outputs)
# for public release.
*.ipynb
!/notebooks/*.ipynb

# Local tooling state
.claude/
AGENTS.md
.mcp.json
.env
.env.*

# OS/editor
.DS_Store
Thumbs.db

# Tabular data and generated exports
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.parquet
# El conjunto de ejemplo del explorador publicado (0,9 MB, solo empresas) si se versiona.
!/explorer/demo/*.parquet
*.feather
*.arrow
*.lst
*.duckdb
*.db
*.sqlite
*.sqlite3

# Downloaded archives
*.zip
*.rar
*.7z

# Local personal workspace: everything inside is ignored except its own README
/exports/*
!/exports/README.md

# Local commercial filters
/posiciones_interes.txt

# Extracción de Tableau (se regenera con tableau/preparar_datos.py)
*.hyper
hyperd*.log
~*.twbr
# Tipografías de la marca para tableau/fondos.py: se bajan de Google Fonts (licencia OFL), no se versionan
tableau/marca/fuentes/
