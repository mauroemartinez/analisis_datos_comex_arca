# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/
# Notebooks often contain outputs, notes, local paths, and exploratory results.
# Tracked only under /notebooks/, and only reviewed and cleaned (no outputs)
# for public release.
*.ipynb
!/notebooks/*.ipynb

# Local AI/tooling state: everything ignored except the shared, reviewed
# skill meant to ship with the repo (see .claude/skills/actualizar-historico-arca).
.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/actualizar-historico-arca/
.codex/
claude_desktop_config.json
.mcp.json
.env
.env.*

# OS/editor
.DS_Store
Thumbs.db

# Tabular data and generated exports
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.parquet
*.feather
*.arrow
*.lst
*.duckdb
*.db
*.sqlite
*.sqlite3

# Downloaded archives
*.zip
*.rar
*.7z

# Local personal workspace: everything inside is ignored except its own README
/exports/*
!/exports/README.md

# Local commercial filters
/posiciones_interes.txt
